---
import SeqeraLogo from "./visuals/seqera-logo.svg";
---

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <p class="hero-pre">A manifesto for bioinformatics</p>
      <h1 class="hero-title">
        <span class="hero-rewrites">rewrites</span><span class="hero-dot">.</span><span class="hero-bio">bio</span>
      </h1>
      <div class="hero-rule"></div>
      <p class="hero-tagline">Rewriting bioinformatics tools with AI. Responsibly.</p>
      <div class="hero-intro">
        <p>
          AI coding assistants have made it possible to rewrite established
          scientific software in days rather than years. A wave of rewrites
          is coming to bioinformatics. These are the principles for doing it right.
        </p>
      </div>
      <a href="https://seqera.io" class="hero-seqera-link"><SeqeraLogo /></a>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .hero :global(.container) {
    max-width: none;
  }

  .hero-content {
    text-align: center;
    padding: var(--space-2xl) 0;
  }

  .hero-pre {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: var(--space-lg);
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: 700;
    line-height: 1;
    margin-bottom: var(--space-md);
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .hero-rewrites {
    color: var(--text-primary);
  }

  .hero-dot {
    color: var(--accent-rust);
  }

  .hero-bio {
    color: var(--accent-rust);
  }

  .hero-rule {
    width: 64px;
    height: 3px;
    background: var(--accent-rust);
    margin: var(--space-lg) auto;
  }

  .hero-tagline {
    font-family: var(--font-sans);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 400;
    color: var(--text-secondary);
    margin-bottom: var(--space-xl);
    letter-spacing: 0.01em;
  }

  .hero-intro {
    max-width: 540px;
    margin: 0 auto;
  }

  .hero-intro p {
    font-size: var(--text-lg);
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .hero-seqera-link {
    display: inline-block;
    margin-top: var(--space-lg);
    opacity: 0.35;
    transition: opacity 0.2s ease;
  }

  .hero-seqera-link:hover {
    opacity: 0.7;
  }

  .hero-seqera-link :global(svg) {
    height: 2.5em;
    width: auto;
  }

</style>
