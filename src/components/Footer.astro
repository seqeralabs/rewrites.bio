---
import SeqeraLogo from "./visuals/seqera-logo.svg";
---

<footer class="site-footer">
  <div class="container">
    <p>
      <a href="https://github.com/seqeralabs/rewrites.bio">Source on GitHub</a>
      &middot;
      Built by <a href="https://seqera.io">Seqera</a>
      &middot;
      <a href="https://github.com/seqeralabs/rewrites.bio">Contributions welcome</a>
    </p>
    <p>
      <a href="https://seqera.io" class="seqera-link"><SeqeraLogo /></a>
    </p>

  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-2xl) 0;
    text-align: center;
    font-size: 0.85rem;
    font-family: var(--font-sans);
    color: var(--text-tertiary);
    border-top: 1px solid rgba(230, 225, 216, 0.04);
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--text-secondary);
  }

  .seqera-link {
    opacity: 0.2;
    transition: opacity 0.2s ease;
    display: inline-block;
    margin-top: 1em;
  }

  .seqera-link:hover {
    opacity: 0.6;
  }

  .seqera-link :global(svg) {
    height: 4em;
    width: auto;
    vertical-align: middle;
  }
</style>
