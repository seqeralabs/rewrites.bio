---
interface Props {
  id: string;
  number: string;
  title: string;
}

const { id, number, title } = Astro.props;
---

<article class="principle reveal" id={id}>
  <div class="principle-number-col">
    <a class="principle-number" href={`#${id}`}>{number}</a>
  </div>
  <div class="principle-content">
    <a class="principle-heading" href={`#${id}`}>
      <h3 class="principle-title">{title}</h3><span class="anchor-link">#</span>
    </a>
    <div class="principle-body">
      <div class="principle-desc">
        <slot name="description" />
      </div>
      <div class="principle-visual">
        <slot name="visual" />
      </div>
    </div>
  </div>
</article>

<style>
  .principle {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-xl) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    scroll-margin-top: 80px;
  }

  .principle:last-child {
    border-bottom: none;
  }

  .principle-number-col {
    flex-shrink: 0;
    width: 48px;
    padding-top: 2px;
  }

  .principle-number {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--rust-500);
    opacity: 0.7;
    text-decoration: none;
  }

  .principle-number:hover {
    opacity: 1;
  }

  .principle-content {
    flex: 1;
    min-width: 0;
  }

  .principle-heading {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    text-decoration: none;
    color: inherit;
    margin-bottom: var(--space-md);
  }

  .principle-heading:hover .anchor-link {
    opacity: 1;
    color: var(--rust-400);
  }

  .principle-title {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
  }

  /* Two-column layout: text left, visual right */
  .principle-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .principle-desc {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .principle-desc :global(p) {
    margin-bottom: var(--space-sm);
  }

  .principle-desc :global(p:last-child) {
    margin-bottom: 0;
  }

  .principle-desc :global(a) {
    color: var(--rust-400);
  }

  .principle-desc :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .principle-desc :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: rgba(255, 255, 255, 0.06);
    padding: 1px 5px;
    border-radius: 3px;
    color: var(--text-primary);
  }

  .principle-visual:empty {
    display: none;
  }

  /* When there is no visual, let text span full width */
  .principle-body:has(.principle-visual:empty) {
    grid-template-columns: 1fr;
  }

  .anchor-link {
    color: var(--rust-600);
    font-weight: 400;
    opacity: 0.4;
    transition: opacity 0.15s ease, color 0.15s ease;
    font-size: 0.85em;
  }

  /* Collapse to single column on narrower screens */
  @media (max-width: 900px) {
    .principle-body {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }

  @media (max-width: 480px) {
    .principle {
      flex-direction: column;
      gap: var(--space-xs);
    }
  }
</style>
