---
interface Props {
  id: string;
  number: string;
  title: string;
}

const { id, number, title } = Astro.props;
---

<article class="principle reveal" id={id}>
  <div class="principle-header">
    <a class="principle-number" href={`#${id}`}>{number}</a>
    <a class="principle-heading" href={`#${id}`}>
      <h3 class="principle-title">{title}</h3><span class="anchor-link">#</span>
    </a>
  </div>
  <div class="principle-body">
    <div class="principle-desc">
      <slot name="description" />
    </div>
    <div class="principle-visual">
      <slot name="visual" />
    </div>
  </div>
</article>

<style>
  .principle {
    padding: var(--space-xl) 0;
    border-bottom: 1px solid rgba(230, 225, 216, 0.06);
    scroll-margin-top: 80px;
  }

  .principle:last-child {
    border-bottom: none;
  }

  .principle-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .principle-number {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--section-color);
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity 0.15s ease;
  }

  .principle-number:hover {
    opacity: 1;
  }

  .principle-heading {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    text-decoration: none;
    color: inherit;
  }

  .principle-heading:hover .anchor-link {
    opacity: 1;
  }

  .principle-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .anchor-link {
    color: var(--section-color);
    font-weight: 400;
    opacity: 0;
    transition: opacity 0.15s ease;
    font-size: 0.85em;
  }

  /* Two-column layout: text left, visual right */
  .principle-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .principle-desc {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .principle-desc :global(p) {
    margin-bottom: var(--space-sm);
  }

  .principle-desc :global(p:last-child) {
    margin-bottom: 0;
  }

  .principle-desc :global(a) {
    color: var(--color-link);
  }

  .principle-desc :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .principle-desc :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: rgba(230, 225, 216, 0.06);
    padding: 1px 5px;
    border-radius: 3px;
    color: var(--text-primary);
  }

  .principle-desc :global(ul) {
    list-style: none;
    padding: 0;
    margin: var(--space-sm) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .principle-desc :global(li) {
    padding-left: var(--space-md);
    border-left: 2px solid var(--section-color);
    line-height: 1.6;
  }

  .principle-visual:empty {
    display: none;
  }

  /* When there is no visual, let text span full width */
  .principle-body:has(.principle-visual:empty) {
    grid-template-columns: 1fr;
  }

  /* Collapse to single column on narrower screens */
  @media (max-width: 900px) {
    .principle-body {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }

  @media (max-width: 480px) {
    .principle-header {
      flex-direction: column;
      gap: var(--space-xs);
    }
  }
</style>
