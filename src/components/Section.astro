---
interface Props {
  id: string;
  number: string;
  title: string;
  intro?: string;
}

const { id, number, title, intro } = Astro.props;
---

<section class="manifesto-section" id={id}>
  <div class="container">
    <div class="section-header-wrap">
      <div class="section-header reveal">
        <a class="section-header-inner" href={`#${id}`}>
          <span class="section-number">{number}</span>
          <h2 class="section-title">{title}<span class="anchor-link">#</span></h2>
        </a>
        <div class="section-line"></div>
      </div>
      {intro && <p class="section-intro reveal">{intro}</p>}
    </div>
    <div class="section-content">
      <slot />
    </div>
  </div>
</section>

<style>
  .manifesto-section {
    padding: var(--space-2xl) 0 var(--space-xl);
    scroll-margin-top: 60px;
  }

  .section-header-wrap {
    margin-bottom: var(--space-xl);
  }

  .section-header {
    padding: var(--space-md) 0;
  }

  .section-header-inner {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    text-decoration: none;
    color: inherit;
  }

  .section-header-inner:hover .section-title {
    color: var(--text-primary);
  }

  .section-header-inner:hover .anchor-link {
    opacity: 1;
    color: var(--rust-400);
  }

  .section-number {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--rust-500);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .section-title {
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .anchor-link {
    color: var(--rust-600);
    font-weight: 400;
    margin-left: 0.3em;
    opacity: 0.4;
    transition: opacity 0.15s ease, color 0.15s ease;
    font-size: 0.7em;
  }

  .section-line {
    width: 48px;
    height: 2px;
    background: linear-gradient(90deg, var(--rust-500), transparent);
    margin-top: var(--space-sm);
  }

  .section-intro {
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin-top: var(--space-lg);
    max-width: 640px;
  }

  .section-content {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
</style>
