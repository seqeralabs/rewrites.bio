<style>
  .toc {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--font-sans);
    font-size: 0.8rem;
  }

  .toc-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: var(--space-sm);
  }

  .toc-item {
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 3px;
    color: var(--text-tertiary);
    text-decoration: none;
    line-height: 1.4;
    transition: color 0.15s ease, background 0.15s ease;
    border-left: 2px solid transparent;
  }

  .toc-item:hover {
    color: var(--text-secondary);
    background: rgba(230, 225, 216, 0.03);
  }

  .toc-intro {
    font-weight: 500;
    color: var(--text-secondary);
  }

  .toc-section {
    font-weight: 600;
    color: var(--text-secondary);
    margin-top: 2px;
  }

  .toc-principle {
    padding-left: 18px;
    font-size: 0.76rem;
  }

  .toc-num {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-tertiary);
    flex-shrink: 0;
    min-width: 20px;
  }

  .toc-section .toc-num {
    color: var(--section-color);
  }

  /* Active states */
  :global(.toc-item.active) {
    color: var(--text-primary);
    border-left-color: var(--section-color);
    background: rgba(230, 225, 216, 0.04);
  }

  :global(.toc-item.active .toc-num) {
    color: var(--section-color);
  }

  :global(.toc-intro.active),
  :global(.toc-principle-intro.active) {
    border-left-color: var(--accent-intro);
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-item {
      transition: none;
    }
  }
</style>
