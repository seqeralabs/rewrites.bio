---
// 3.2 — Build only what you need: scope checklist with boundary styling
---

<div class="scope-wrap">
  <div class="scope-label">Scope Definition — samtools rewrite (example)</div>
  <div class="scope-columns">
    <div class="scope-col scope-in">
      <div class="scope-col-header">In scope</div>
      <div class="scope-item">
        <span class="scope-icon scope-icon-pass">✓</span>
        <div>
          <span class="scope-name">sort</span>
          <span class="scope-detail">coordinate &amp; name sort</span>
        </div>
      </div>
      <div class="scope-item">
        <span class="scope-icon scope-icon-pass">✓</span>
        <div>
          <span class="scope-name">index</span>
          <span class="scope-detail">BAI generation</span>
        </div>
      </div>
      <div class="scope-item">
        <span class="scope-icon scope-icon-pass">✓</span>
        <div>
          <span class="scope-name">flagstat</span>
          <span class="scope-detail">alignment statistics</span>
        </div>
      </div>
      <div class="scope-item">
        <span class="scope-icon scope-icon-pass">✓</span>
        <div>
          <span class="scope-name">view</span>
          <span class="scope-detail">format conversion</span>
        </div>
      </div>
    </div>
    <div class="scope-col scope-out">
      <div class="scope-col-header">Out of scope</div>
      <div class="scope-item">
        <span class="scope-icon scope-icon-skip">○</span>
        <div>
          <span class="scope-name">mpileup</span>
          <span class="scope-detail">not used in pipeline</span>
        </div>
      </div>
      <div class="scope-item">
        <span class="scope-icon scope-icon-skip">○</span>
        <div>
          <span class="scope-name">merge</span>
          <span class="scope-detail">handled upstream</span>
        </div>
      </div>
      <div class="scope-item">
        <span class="scope-icon scope-icon-skip">○</span>
        <div>
          <span class="scope-name">fasta/fastq</span>
          <span class="scope-detail">not in critical path</span>
        </div>
      </div>
      <div class="scope-item">
        <span class="scope-icon scope-icon-skip">○</span>
        <div>
          <span class="scope-name">depth</span>
          <span class="scope-detail">deferred to v2</span>
        </div>
      </div>
    </div>
  </div>
  <div class="scope-note">
    A rewrite that does four things correctly is more valuable than one that claims fifteen.
  </div>
</div>

<style>
  .scope-wrap {
    background: var(--bg-secondary);
    border-left: 3px solid var(--section-color, var(--accent-gold));
    padding: var(--space-lg);
  }

  .scope-label {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-tertiary);
    margin-bottom: var(--space-md);
  }

  .scope-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .scope-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .scope-in {
    padding: var(--space-sm);
    border: 1.5px dashed var(--section-color, var(--accent-gold));
    border-radius: 6px;
  }

  .scope-out {
    padding: var(--space-sm);
  }

  .scope-col-header {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .scope-in .scope-col-header {
    color: var(--section-color, var(--accent-gold));
  }

  .scope-out .scope-col-header {
    color: var(--text-tertiary);
  }

  .scope-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .scope-icon {
    font-size: 0.8rem;
    flex-shrink: 0;
    line-height: 1.4;
  }

  .scope-icon-pass {
    color: var(--color-pass);
  }

  .scope-icon-skip {
    color: var(--text-tertiary);
    opacity: 0.5;
  }

  .scope-name {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    display: block;
  }

  .scope-in .scope-name {
    color: var(--text-primary);
  }

  .scope-out .scope-name {
    color: var(--text-tertiary);
  }

  .scope-detail {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--text-tertiary);
    display: block;
    line-height: 1.3;
  }

  .scope-note {
    font-family: var(--font-serif);
    font-size: 0.8rem;
    color: var(--text-tertiary);
    border-top: 1px solid rgba(230, 225, 216, 0.06);
    padding-top: var(--space-sm);
    font-style: italic;
  }

  @media (max-width: 400px) {
    .scope-columns {
      grid-template-columns: 1fr;
    }
  }
</style>
