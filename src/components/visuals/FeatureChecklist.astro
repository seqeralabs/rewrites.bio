---
// 3.4 — Build only what you need: feature scope checklist
---

<div class="checklist-wrap">
  <div class="checklist-label">SCOPE DEFINITION — samtools rewrite (example)</div>
  <div class="checklist-cols">
    <div class="checklist-col">
      <div class="col-head col-head-in">In scope — required for pipeline</div>
      <div class="check-items">
        <div class="check-item check-done">
          <span class="ci-icon">✓</span>
          <div class="ci-content">
            <div class="ci-name">samtools sort</div>
            <div class="ci-note">coordinate &amp; name sort</div>
          </div>
        </div>
        <div class="check-item check-done">
          <span class="ci-icon">✓</span>
          <div class="ci-content">
            <div class="ci-name">samtools index</div>
            <div class="ci-note">BAI format</div>
          </div>
        </div>
        <div class="check-item check-done">
          <span class="ci-icon">✓</span>
          <div class="ci-content">
            <div class="ci-name">samtools flagstat</div>
            <div class="ci-note">all flags, identical output format</div>
          </div>
        </div>
        <div class="check-item check-done">
          <span class="ci-icon">✓</span>
          <div class="ci-content">
            <div class="ci-name">samtools view</div>
            <div class="ci-note">filter, convert SAM↔BAM↔CRAM</div>
          </div>
        </div>
      </div>
    </div>

    <div class="checklist-col">
      <div class="col-head col-head-out">Out of scope — for now</div>
      <div class="check-items">
        <div class="check-item check-later">
          <span class="ci-icon">○</span>
          <div class="ci-content">
            <div class="ci-name">samtools mpileup</div>
            <div class="ci-note">not used in target pipeline</div>
          </div>
        </div>
        <div class="check-item check-later">
          <span class="ci-icon">○</span>
          <div class="ci-content">
            <div class="ci-name">samtools merge</div>
            <div class="ci-note">handled upstream by nextflow</div>
          </div>
        </div>
        <div class="check-item check-later">
          <span class="ci-icon">○</span>
          <div class="ci-content">
            <div class="ci-name">samtools fasta/fastq</div>
            <div class="ci-note">low priority, add later</div>
          </div>
        </div>
        <div class="check-item check-later">
          <span class="ci-icon">○</span>
          <div class="ci-content">
            <div class="ci-name">samtools depth</div>
            <div class="ci-note">separate tool handles this</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .checklist-wrap {
    background: var(--bg-surface);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: var(--space-lg);
  }

  .checklist-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: var(--space-md);
  }

  .checklist-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  @media (max-width: 560px) {
    .checklist-cols {
      grid-template-columns: 1fr;
    }
  }

  .checklist-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .col-head {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 4px 0;
    border-bottom: 2px solid;
    margin-bottom: 4px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .col-head-in {
    color: rgba(74, 222, 128, 0.8);
    border-color: rgba(74, 222, 128, 0.3);
  }

  .col-head-out {
    color: var(--text-tertiary);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .check-items {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .check-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: 6px 8px;
    border-radius: 4px;
    background: var(--bg-primary);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .check-done {
    border-color: rgba(74, 222, 128, 0.12);
    background: rgba(74, 222, 128, 0.03);
  }

  .check-later {
    opacity: 0.55;
  }

  .ci-icon {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .check-done .ci-icon { color: rgba(74, 222, 128, 0.8); }
  .check-later .ci-icon { color: var(--text-tertiary); }

  .ci-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ci-name {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .ci-note {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--text-tertiary);
  }
</style>
