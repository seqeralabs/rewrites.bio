---
// Preamble: scale/cost — horizontal bar chart
// Real data from RustQC benchmarks on a 10GB BAM file:
// - Traditional tools: 15h 34m
// - RustQC: 14m 54s
// ~63× speedup
---

<div class="chart-wrap">
  <div class="chart-example">Example: RustQC</div>
  <div class="chart-title">Time per sample - RustQC on 10 GB BAM</div>

  <div class="chart-group">
    <div class="bar-row">
      <div class="bar-name">Traditional tools</div>
      <div class="bar-track">
        <div class="bar bar-old" style="width: 100%"></div>
      </div>
      <span class="bar-val">15:34:00</span>
    </div>
    <div class="bar-row">
      <div class="bar-name">RustQC</div>
      <div class="bar-track">
        <div class="bar bar-new" style="width: 1.6%"></div>
      </div>
      <span class="bar-val">00:14:54</span>
    </div>
  </div>

  <div class="chart-context">At 100k samples/year:</div>
  <div class="chart-stats">
    <div class="stat">
      <svg
        class="stat-icon"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M10 2h4"></path><path d="M12 14l3-3"></path><circle
          cx="12"
          cy="14"
          r="8"></circle>
      </svg>
      <div class="stat-value">63x</div>
      <div class="stat-label">faster</div>
    </div>
    <div class="stat">
      <svg
        class="stat-icon"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path
          d="M12 20v2m0-20v2m5 16v2m0-20v2M2 12h2m-2 5h2M2 7h2m16 5h2m-2 5h2M20 7h2M7 20v2M7 2v2"
        ></path><rect width="16" height="16" x="4" y="4" rx="2"></rect><rect
          width="8"
          height="8"
          x="8"
          y="8"
          rx="1"></rect>
      </svg>
      <div class="stat-value">1.5M</div>
      <div class="stat-label">CPU-hours saved</div>
    </div>
    <div class="stat">
      <svg
        class="stat-icon"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path
          d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"
        ></path>
      </svg>
      <div class="stat-value">98%</div>
      <div class="stat-label">less energy</div>
    </div>
    <div class="stat">
      <svg
        class="stat-icon"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path
          d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8c0 5.5-4.78 10-10 10"
        ></path><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"
        ></path>
      </svg>
      <div class="stat-value">~150t</div>
      <div class="stat-label">CO₂e saved</div>
    </div>
  </div>
  <div class="chart-source">
    Source: <a
      href="https://seqeralabs.github.io/RustQC/rna/benchmark-details/"
      target="_blank"
      rel="noopener">RustQC benchmark details</a
    >
  </div>
</div>

<style>
  .chart-wrap {
    background: var(--bg-secondary);
    border-left: 3px solid var(--section-color, var(--accent-rust));
    border-top: none;
    border-right: none;
    border-bottom: none;
    padding: var(--space-lg);
  }

  .chart-example {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--section-color, var(--accent-rust));
    margin-bottom: var(--space-xs);
  }

  .chart-title {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: var(--space-lg);
  }

  .chart-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .bar-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .bar-name {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--text-tertiary);
    width: 95px;
    flex-shrink: 0;
    text-align: right;
  }

  .bar-track {
    flex: 1;
    height: 24px;
    background: rgba(230, 225, 216, 0.03);
    border-radius: 2px;
    position: relative;
  }

  .bar {
    height: 100%;
    border-radius: 2px;
    min-width: 3px;
  }

  .bar-old {
    background: var(--color-fail);
    opacity: 0.5;
    position: relative;
    overflow: hidden;
  }

  .bar-old::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 50%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.15),
      transparent
    );
    animation: bar-shimmer 3s ease-in-out infinite;
    animation-delay: 1.5s;
  }

  @keyframes bar-shimmer {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(350%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar-old::after {
      display: none;
    }
  }

  .bar-new {
    background: var(--color-pass);
    opacity: 0.7;
  }

  .bar-val {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-tertiary);
    width: 50px;
    flex-shrink: 0;
    text-align: left;
  }

  .chart-context {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid rgba(230, 225, 216, 0.06);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: var(--space-sm);
  }

  .chart-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-sm);
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 4px;
  }

  .stat-icon {
    width: 20px;
    height: 20px;
    color: var(--text-tertiary);
    margin-bottom: 2px;
  }

  .stat-value {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
  }

  .stat-label {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    color: var(--text-tertiary);
    line-height: 1.3;
  }

  @media (max-width: 480px) {
    .chart-stats {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md);
    }
  }

  .chart-source {
    font-family: var(--font-serif);
    font-size: 0.72rem;
    color: var(--text-tertiary);
    margin-top: var(--space-md);
  }
</style>
