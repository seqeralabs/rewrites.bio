---
// Preamble: scale/cost — horizontal bar chart for right-column layout
// Real data from RustQC benchmarks on a 10GB BAM file:
// - Traditional tools: 4h 06m (246 min)
// - RustQC: 7m 10s (7.17 min)
// ~34× speedup
---

<div class="chart-wrap">
  <div class="chart-title">CPU-hours per year · QC on 10GB BAM files (RustQC data)</div>

  <div class="chart-groups">

    <div class="group">
      <div class="group-label">1k samples/yr</div>
      <div class="group-bars">
        <div class="bar-row">
          <div class="bar-name">Legacy</div>
          <div class="bar-track"><div class="bar bar-old" style="width: 10%"></div></div>
          <span class="bar-val">4,100h</span>
        </div>
        <div class="bar-row">
          <div class="bar-name">RustQC</div>
          <div class="bar-track"><div class="bar bar-new" style="width: 0.3%"></div></div>
          <span class="bar-val">120h</span>
        </div>
      </div>
    </div>

    <div class="group">
      <div class="group-label">10k samples/yr</div>
      <div class="group-bars">
        <div class="bar-row">
          <div class="bar-name">Legacy</div>
          <div class="bar-track"><div class="bar bar-old" style="width: 50%"></div></div>
          <span class="bar-val">41,000h</span>
        </div>
        <div class="bar-row">
          <div class="bar-name">RustQC</div>
          <div class="bar-track"><div class="bar bar-new" style="width: 1.5%"></div></div>
          <span class="bar-val">1,200h</span>
        </div>
      </div>
    </div>

    <div class="group">
      <div class="group-label">100k samples/yr</div>
      <div class="group-bars">
        <div class="bar-row">
          <div class="bar-name">Legacy</div>
          <div class="bar-track"><div class="bar bar-old" style="width: 100%"></div></div>
          <span class="bar-val">410,000h</span>
        </div>
        <div class="bar-row">
          <div class="bar-name">RustQC</div>
          <div class="bar-track"><div class="bar bar-new" style="width: 3%"></div></div>
          <span class="bar-val">12,000h</span>
        </div>
      </div>
    </div>

  </div>

  <div class="chart-annotation">
    <strong>34× faster</strong> · Saving ~400,000 CPU-hours/year at scale is <strong>~40 tonnes CO₂e</strong> avoided.
  </div>
</div>

<style>
  .chart-wrap {
    background: var(--bg-surface);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: var(--space-lg);
  }

  .chart-title {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-lg);
  }

  .chart-groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .group-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .group-bars {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .bar-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .bar-name {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-tertiary);
    width: 46px;
    flex-shrink: 0;
    text-align: right;
  }

  .bar-track {
    flex: 1;
    height: 18px;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 2px;
    position: relative;
  }

  .bar {
    height: 100%;
    border-radius: 2px;
    min-width: 3px;
  }

  .bar-old {
    background: rgba(249, 115, 22, 0.5);
    border: 1px solid rgba(249, 115, 22, 0.7);
  }

  .bar-new {
    background: rgba(74, 222, 128, 0.3);
    border: 1px solid rgba(74, 222, 128, 0.6);
  }

  .bar-val {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-tertiary);
    width: 32px;
    flex-shrink: 0;
    text-align: left;
  }

  .chart-annotation {
    margin-top: var(--space-lg);
    font-size: 0.82rem;
    color: var(--text-tertiary);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: var(--space-sm);
    line-height: 1.6;
  }

  .chart-annotation strong {
    color: var(--rust-400);
  }
</style>
