---
// Preamble: scale/cost — horizontal bar chart
// Real data from RustQC benchmarks on a 10GB BAM file:
// - Traditional tools: 4h 06m (246 min)
// - RustQC: 7m 10s (7.17 min)
// ~34× speedup
---

<div class="chart-wrap">
  <div class="chart-title">CPU-hours per year — QC on 10 GB BAM files</div>

  <div class="chart-groups">

    <div class="group">
      <div class="group-label">1k samples/yr</div>
      <div class="group-bars">
        <div class="bar-row">
          <div class="bar-name">Legacy</div>
          <div class="bar-track"><div class="bar bar-old" style="width: 10%"></div></div>
          <span class="bar-val">4,100 h</span>
        </div>
        <div class="bar-row">
          <div class="bar-name">Rewrite</div>
          <div class="bar-track"><div class="bar bar-new" style="width: 0.3%"></div></div>
          <span class="bar-val">120 h</span>
        </div>
      </div>
    </div>

    <div class="group">
      <div class="group-label">10k samples/yr</div>
      <div class="group-bars">
        <div class="bar-row">
          <div class="bar-name">Legacy</div>
          <div class="bar-track"><div class="bar bar-old" style="width: 50%"></div></div>
          <span class="bar-val">41,000 h</span>
        </div>
        <div class="bar-row">
          <div class="bar-name">Rewrite</div>
          <div class="bar-track"><div class="bar bar-new" style="width: 1.5%"></div></div>
          <span class="bar-val">1,200 h</span>
        </div>
      </div>
    </div>

    <div class="group">
      <div class="group-label">100k samples/yr</div>
      <div class="group-bars">
        <div class="bar-row">
          <div class="bar-name">Legacy</div>
          <div class="bar-track"><div class="bar bar-old" style="width: 100%"></div></div>
          <span class="bar-val">410,000 h</span>
        </div>
        <div class="bar-row">
          <div class="bar-name">Rewrite</div>
          <div class="bar-track"><div class="bar bar-new" style="width: 3%"></div></div>
          <span class="bar-val">12,000 h</span>
        </div>
      </div>
    </div>

  </div>

  <div class="chart-annotation">
    <strong>34x faster</strong> — saving ~400,000 CPU-hours/year at scale is <strong>~40 tonnes CO₂e</strong> avoided.
  </div>
  <div class="chart-source">Source: RustQC benchmarks</div>
</div>

<style>
  .chart-wrap {
    background: var(--bg-secondary);
    border-left: 3px solid var(--section-color, var(--accent-rust));
    border-top: none;
    border-right: none;
    border-bottom: none;
    padding: var(--space-lg);
  }

  .chart-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: var(--space-lg);
  }

  .chart-groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .group-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-tertiary);
    font-weight: 500;
  }

  .group-bars {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .bar-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .bar-name {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--text-tertiary);
    width: 50px;
    flex-shrink: 0;
    text-align: right;
  }

  .bar-track {
    flex: 1;
    height: 18px;
    background: rgba(230, 225, 216, 0.03);
    border-radius: 2px;
    position: relative;
  }

  .bar {
    height: 100%;
    border-radius: 2px;
    min-width: 3px;
  }

  .bar-old {
    background: var(--color-fail);
    opacity: 0.5;
  }

  .bar-new {
    background: var(--color-pass);
    opacity: 0.7;
  }

  .bar-val {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-tertiary);
    width: 50px;
    flex-shrink: 0;
    text-align: left;
  }

  .chart-annotation {
    margin-top: var(--space-lg);
    font-size: 0.85rem;
    color: var(--text-secondary);
    border-top: 1px solid rgba(230, 225, 216, 0.06);
    padding-top: var(--space-sm);
    line-height: 1.6;
  }

  .chart-annotation strong {
    color: var(--text-primary);
  }

  .chart-source {
    font-family: var(--font-serif);
    font-size: 0.72rem;
    color: var(--text-tertiary);
    margin-top: var(--space-xs);
  }
</style>
