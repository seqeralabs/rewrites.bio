---
// 3.3 — Pin versions and document: Version timeline
---

<div class="timeline-wrap">
  <svg
    viewBox="0 0 520 215"
    role="img"
    aria-label="Version timeline showing three tools with pinned validated versions and untested future versions"
    xmlns="http://www.w3.org/2000/svg"
    class="timeline-svg"
  >
    <!-- Validated line -->
    <line
      x1="310"
      y1="20"
      x2="310"
      y2="210"
      stroke="var(--section-color, var(--accent-gold))"
      stroke-width="2"></line>
    <rect
      x="272"
      y="4"
      width="76"
      height="22"
      rx="3"
      fill="var(--section-color, var(--accent-gold))"
      opacity="0.15"></rect>
    <text
      x="310"
      y="19"
      text-anchor="middle"
      font-family="var(--font-sans)"
      font-size="15"
      font-weight="700"
      fill="var(--section-color, var(--accent-gold))">Validated</text
    >

    <!-- Track labels -->
    <text
      x="12"
      y="72"
      font-family="var(--font-mono)"
      font-size="15"
      fill="var(--text-secondary)">tool-a</text
    >
    <text
      x="12"
      y="132"
      font-family="var(--font-mono)"
      font-size="15"
      fill="var(--text-secondary)">tool-b</text
    >
    <text
      x="12"
      y="192"
      font-family="var(--font-mono)"
      font-size="15"
      fill="var(--text-secondary)">tool-c</text
    >

    <!-- Track lines -->
    <line
      x1="80"
      y1="68"
      x2="470"
      y2="68"
      stroke="var(--text-tertiary)"
      stroke-width="0.5"
      opacity="0.2"></line>
    <line
      x1="80"
      y1="128"
      x2="470"
      y2="128"
      stroke="var(--text-tertiary)"
      stroke-width="0.5"
      opacity="0.2"></line>
    <line
      x1="80"
      y1="188"
      x2="470"
      y2="188"
      stroke="var(--text-tertiary)"
      stroke-width="0.5"
      opacity="0.2"></line>

    <!-- tool-a: v0.9 → v1.0 → v1.1 -->
    <!-- v0.9 (before validated) -->
    <circle
      cx="140"
      cy="68"
      r="6"
      fill="var(--section-color, var(--accent-gold))"></circle>
    <text
      x="140"
      y="56"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="15"
      fill="var(--text-tertiary)"
      stroke="var(--bg-secondary)"
      stroke-width="8"
      paint-order="stroke">v0.9</text
    >
    <!-- v1.0 (at validated) -->
    <circle
      cx="310"
      cy="68"
      r="7"
      fill="var(--section-color, var(--accent-gold))"></circle>
    <text
      x="310"
      y="56"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="15"
      font-weight="600"
      fill="var(--text-primary)"
      stroke="var(--bg-secondary)"
      stroke-width="8"
      paint-order="stroke">v1.0</text
    >
    <!-- Connecting line between dots -->
    <line
      x1="146"
      y1="68"
      x2="303"
      y2="68"
      stroke="var(--section-color, var(--accent-gold))"
      stroke-width="1"
      opacity="0.3"></line>
    <!-- v1.1 (after validated — hollow) -->
    <circle
      cx="410"
      cy="68"
      r="6"
      fill="none"
      stroke="var(--text-tertiary)"
      stroke-width="1.2"
      stroke-dasharray="3 2"></circle>
    <text
      x="410"
      y="56"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="15"
      fill="var(--text-tertiary)"
      opacity="0.6"
      stroke="var(--bg-secondary)"
      stroke-width="8"
      paint-order="stroke">v1.1</text
    >
    <line
      x1="317"
      y1="68"
      x2="404"
      y2="68"
      stroke="var(--text-tertiary)"
      stroke-width="1"
      opacity="0.15"
      stroke-dasharray="3 2"></line>

    <!-- tool-b: v2.1 → v2.3 → v2.4 -->
    <!-- v2.1 (before validated) -->
    <circle
      cx="120"
      cy="128"
      r="6"
      fill="var(--section-color, var(--accent-gold))"></circle>
    <text
      x="120"
      y="116"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="15"
      fill="var(--text-tertiary)"
      stroke="var(--bg-secondary)"
      stroke-width="8"
      paint-order="stroke">v2.1</text
    >
    <!-- v2.3 (at validated) -->
    <circle
      cx="310"
      cy="128"
      r="7"
      fill="var(--section-color, var(--accent-gold))"></circle>
    <text
      x="310"
      y="116"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="15"
      font-weight="600"
      fill="var(--text-primary)"
      stroke="var(--bg-secondary)"
      stroke-width="8"
      paint-order="stroke">v2.3</text
    >
    <line
      x1="126"
      y1="128"
      x2="303"
      y2="128"
      stroke="var(--section-color, var(--accent-gold))"
      stroke-width="1"
      opacity="0.3"></line>
    <!-- v2.4 (after validated — hollow) -->
    <circle
      cx="430"
      cy="128"
      r="6"
      fill="none"
      stroke="var(--text-tertiary)"
      stroke-width="1.2"
      stroke-dasharray="3 2"></circle>
    <text
      x="430"
      y="116"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="15"
      fill="var(--text-tertiary)"
      opacity="0.6"
      stroke="var(--bg-secondary)"
      stroke-width="8"
      paint-order="stroke">v2.4</text
    >
    <line
      x1="317"
      y1="128"
      x2="424"
      y2="128"
      stroke="var(--text-tertiary)"
      stroke-width="1"
      opacity="0.15"
      stroke-dasharray="3 2"></line>

    <!-- tool-c: v0.8 → v0.9 → v1.0 -->
    <!-- v0.8 (before validated) -->
    <circle
      cx="160"
      cy="188"
      r="6"
      fill="var(--section-color, var(--accent-gold))"></circle>
    <text
      x="160"
      y="176"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="15"
      fill="var(--text-tertiary)"
      stroke="var(--bg-secondary)"
      stroke-width="8"
      paint-order="stroke">v0.8</text
    >
    <!-- v0.9 (at validated) -->
    <circle
      cx="310"
      cy="188"
      r="7"
      fill="var(--section-color, var(--accent-gold))"></circle>
    <text
      x="310"
      y="176"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="15"
      font-weight="600"
      fill="var(--text-primary)"
      stroke="var(--bg-secondary)"
      stroke-width="8"
      paint-order="stroke">v0.9</text
    >
    <line
      x1="166"
      y1="188"
      x2="303"
      y2="188"
      stroke="var(--section-color, var(--accent-gold))"
      stroke-width="1"
      opacity="0.3"></line>
    <!-- v1.0 (after validated — hollow) -->
    <circle
      cx="450"
      cy="188"
      r="6"
      fill="none"
      stroke="var(--text-tertiary)"
      stroke-width="1.2"
      stroke-dasharray="3 2"></circle>
    <text
      x="450"
      y="176"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="15"
      fill="var(--text-tertiary)"
      opacity="0.6"
      stroke="var(--bg-secondary)"
      stroke-width="8"
      paint-order="stroke">v1.0</text
    >
    <line
      x1="317"
      y1="188"
      x2="444"
      y2="188"
      stroke="var(--text-tertiary)"
      stroke-width="1"
      opacity="0.15"
      stroke-dasharray="3 2"></line>
  </svg>
</div>

<style>
  .timeline-wrap {
    background: var(--bg-secondary);
    border-left: 3px solid var(--section-color, var(--accent-rust));
    padding: var(--space-lg);
  }

  .timeline-svg {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
