---
// 3.3 — Pin versions and document: Version timeline
---

<div class="timeline-wrap">
  <svg
    viewBox="0 0 520 240"
    role="img"
    aria-label="Version timeline showing three tools with pinned validated versions and untested future versions"
    xmlns="http://www.w3.org/2000/svg"
    class="timeline-svg"
  >
    <!-- Time arrow at bottom -->
    <line x1="80" y1="210" x2="490" y2="210" stroke="var(--text-tertiary)" stroke-width="1" opacity="0.4" />
    <polygon points="490,210 483,207 483,213" fill="var(--text-tertiary)" opacity="0.4" />
    <text x="495" y="214" font-family="var(--font-sans)" font-size="12" fill="var(--text-tertiary)">time</text>

    <!-- Validated line -->
    <line x1="310" y1="20" x2="310" y2="200" stroke="var(--section-color, var(--accent-gold))" stroke-width="2" />
    <rect x="278" y="6" width="64" height="18" rx="3" fill="var(--section-color, var(--accent-gold))" opacity="0.15" />
    <text x="310" y="19" text-anchor="middle" font-family="var(--font-sans)" font-size="12" font-weight="700" fill="var(--section-color, var(--accent-gold))">Validated</text>

    <!-- Track labels -->
    <text x="12" y="72" font-family="var(--font-mono)" font-size="13" fill="var(--text-secondary)">tool-a</text>
    <text x="12" y="122" font-family="var(--font-mono)" font-size="13" fill="var(--text-secondary)">tool-b</text>
    <text x="12" y="172" font-family="var(--font-mono)" font-size="13" fill="var(--text-secondary)">tool-c</text>

    <!-- Track lines -->
    <line x1="80" y1="68" x2="470" y2="68" stroke="var(--text-tertiary)" stroke-width="0.5" opacity="0.2" />
    <line x1="80" y1="118" x2="470" y2="118" stroke="var(--text-tertiary)" stroke-width="0.5" opacity="0.2" />
    <line x1="80" y1="168" x2="470" y2="168" stroke="var(--text-tertiary)" stroke-width="0.5" opacity="0.2" />

    <!-- tool-a: v0.9 → v1.0 → v1.1 -->
    <!-- v0.9 (before validated) -->
    <circle cx="140" cy="68" r="6" fill="var(--section-color, var(--accent-gold))" />
    <text x="140" y="56" text-anchor="middle" font-family="var(--font-mono)" font-size="12" fill="var(--text-tertiary)">v0.9</text>
    <!-- v1.0 (at validated) -->
    <circle cx="310" cy="68" r="7" fill="var(--section-color, var(--accent-gold))" />
    <text x="310" y="56" text-anchor="middle" font-family="var(--font-mono)" font-size="12" font-weight="600" fill="var(--text-primary)">v1.0</text>
    <!-- Connecting line between dots -->
    <line x1="146" y1="68" x2="303" y2="68" stroke="var(--section-color, var(--accent-gold))" stroke-width="1" opacity="0.3" />
    <!-- v1.1 (after validated — hollow) -->
    <circle cx="410" cy="68" r="6" fill="none" stroke="var(--text-tertiary)" stroke-width="1.2" stroke-dasharray="3 2" />
    <text x="410" y="56" text-anchor="middle" font-family="var(--font-mono)" font-size="12" fill="var(--text-tertiary)" opacity="0.6">v1.1</text>
    <line x1="317" y1="68" x2="404" y2="68" stroke="var(--text-tertiary)" stroke-width="1" opacity="0.15" stroke-dasharray="3 2" />

    <!-- tool-b: v2.1 → v2.3 → v2.4 -->
    <!-- v2.1 (before validated) -->
    <circle cx="120" cy="118" r="6" fill="var(--section-color, var(--accent-gold))" />
    <text x="120" y="106" text-anchor="middle" font-family="var(--font-mono)" font-size="12" fill="var(--text-tertiary)">v2.1</text>
    <!-- v2.3 (at validated) -->
    <circle cx="310" cy="118" r="7" fill="var(--section-color, var(--accent-gold))" />
    <text x="310" y="106" text-anchor="middle" font-family="var(--font-mono)" font-size="12" font-weight="600" fill="var(--text-primary)">v2.3</text>
    <line x1="126" y1="118" x2="303" y2="118" stroke="var(--section-color, var(--accent-gold))" stroke-width="1" opacity="0.3" />
    <!-- v2.4 (after validated — hollow) -->
    <circle cx="430" cy="118" r="6" fill="none" stroke="var(--text-tertiary)" stroke-width="1.2" stroke-dasharray="3 2" />
    <text x="430" y="106" text-anchor="middle" font-family="var(--font-mono)" font-size="12" fill="var(--text-tertiary)" opacity="0.6">v2.4</text>
    <line x1="317" y1="118" x2="424" y2="118" stroke="var(--text-tertiary)" stroke-width="1" opacity="0.15" stroke-dasharray="3 2" />

    <!-- tool-c: v0.8 → v0.9 → v1.0 -->
    <!-- v0.8 (before validated) -->
    <circle cx="160" cy="168" r="6" fill="var(--section-color, var(--accent-gold))" />
    <text x="160" y="156" text-anchor="middle" font-family="var(--font-mono)" font-size="12" fill="var(--text-tertiary)">v0.8</text>
    <!-- v0.9 (at validated) -->
    <circle cx="310" cy="168" r="7" fill="var(--section-color, var(--accent-gold))" />
    <text x="310" y="156" text-anchor="middle" font-family="var(--font-mono)" font-size="12" font-weight="600" fill="var(--text-primary)">v0.9</text>
    <line x1="166" y1="168" x2="303" y2="168" stroke="var(--section-color, var(--accent-gold))" stroke-width="1" opacity="0.3" />
    <!-- v1.0 (after validated — hollow) -->
    <circle cx="450" cy="168" r="6" fill="none" stroke="var(--text-tertiary)" stroke-width="1.2" stroke-dasharray="3 2" />
    <text x="450" y="156" text-anchor="middle" font-family="var(--font-mono)" font-size="12" fill="var(--text-tertiary)" opacity="0.6">v1.0</text>
    <line x1="317" y1="168" x2="444" y2="168" stroke="var(--text-tertiary)" stroke-width="1" opacity="0.15" stroke-dasharray="3 2" />
  </svg>
  <div class="timeline-note">
    Future maintainers need to know exactly what was validated against what.
  </div>
</div>

<style>
  .timeline-wrap {
    background: var(--bg-secondary);
    border-left: 3px solid var(--section-color, var(--accent-rust));
    padding: var(--space-lg);
  }

  .timeline-svg {
    width: 100%;
    height: auto;
    display: block;
    margin-bottom: var(--space-md);
  }

  .timeline-note {
    font-family: var(--font-serif);
    font-size: 0.83rem;
    color: var(--text-tertiary);
    border-top: 1px solid rgba(230, 225, 216, 0.06);
    padding-top: var(--space-sm);
    line-height: 1.6;
    font-style: italic;
  }
</style>
