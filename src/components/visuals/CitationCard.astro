---
// 1.1 — Credit the original authors
// Shows: researcher uses RustQC → their paper must cite featureCounts (required) and optionally RustQC
---

<div class="provenance-wrap">
  <svg
    class="provenance-svg"
    viewBox="0 0 340 440"
    role="img"
    aria-label="Citation diagram showing that a paper using RustQC must cite the original featureCounts, and optionally cite RustQC"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <marker id="arr" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <path d="M0,0 L8,3 L0,6" fill="var(--text-tertiary)" />
      </marker>
      <marker id="arr-req" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <path d="M0,0 L8,3 L0,6" fill="var(--section-color, var(--accent-rust))" />
      </marker>
      <marker id="arr-opt" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <path d="M0,0 L8,3 L0,6" fill="var(--text-tertiary)" />
      </marker>
    </defs>

    <!-- Row 1: Your paper -->
    <rect x="70" y="16" width="200" height="56" rx="6"
      fill="var(--bg-elevated)" stroke="var(--text-tertiary)" stroke-width="1" />
    <text x="170" y="42" text-anchor="middle"
      font-family="var(--font-sans)" font-size="14" font-weight="600"
      fill="var(--text-primary)">Your paper</text>
    <text x="170" y="60" text-anchor="middle"
      font-family="var(--font-sans)" font-size="11"
      fill="var(--text-tertiary)">uses RustQC for QC</text>

    <!-- Arrow: Your paper → RustQC -->
    <line x1="170" y1="72" x2="170" y2="112"
      stroke="var(--text-tertiary)" stroke-width="1.5" marker-end="url(#arr)" />
    <text x="184" y="97" font-family="var(--font-sans)" font-size="10"
      fill="var(--text-tertiary)">uses</text>

    <!-- Row 2: RustQC -->
    <rect x="70" y="120" width="200" height="56" rx="6"
      fill="var(--bg-primary)" stroke="var(--section-color, var(--accent-rust))" stroke-width="1.5" />
    <text x="170" y="146" text-anchor="middle"
      font-family="var(--font-mono)" font-size="15" font-weight="600"
      fill="var(--section-color, var(--accent-rust))">RustQC</text>
    <text x="170" y="164" text-anchor="middle"
      font-family="var(--font-sans)" font-size="11"
      fill="var(--text-tertiary)">AI-assisted rewrite · 2024</text>

    <!-- Arrow: RustQC → featureCounts -->
    <line x1="170" y1="176" x2="170" y2="216"
      stroke="var(--text-tertiary)" stroke-width="1.5" marker-end="url(#arr)" />
    <text x="184" y="200" font-family="var(--font-sans)" font-size="10"
      fill="var(--text-tertiary)">built on</text>

    <!-- Row 3: featureCounts -->
    <rect x="70" y="224" width="200" height="56" rx="6"
      fill="var(--bg-primary)" stroke="var(--text-tertiary)" stroke-width="1" />
    <text x="170" y="250" text-anchor="middle"
      font-family="var(--font-mono)" font-size="14" font-weight="600"
      fill="var(--text-secondary)">featureCounts</text>
    <text x="170" y="268" text-anchor="middle"
      font-family="var(--font-sans)" font-size="11"
      fill="var(--text-tertiary)">Liao, Smyth &amp; Shi · 2014</text>

    <!-- DOI badge -->
    <rect x="110" y="286" width="120" height="20" rx="3"
      fill="var(--bg-elevated)" stroke="var(--text-tertiary)" stroke-width="0.5" />
    <text x="130" y="300" font-family="var(--font-mono)" font-size="8.5"
      font-weight="700" fill="var(--text-tertiary)">DOI</text>
    <text x="152" y="300" font-family="var(--font-mono)" font-size="8.5"
      fill="var(--text-secondary)">10.1093/btt656</text>

    <!-- Citation arrows from "Your paper" -->

    <!-- Required: cite featureCounts (solid, prominent) -->
    <path d="M56,44 L20,44 L20,252 L62,252"
      fill="none" stroke="var(--section-color, var(--accent-rust))" stroke-width="2"
      marker-end="url(#arr-req)" />
    <text x="14" y="160" text-anchor="middle"
      font-family="var(--font-sans)" font-size="11" font-weight="700"
      fill="var(--section-color, var(--accent-rust))"
      transform="rotate(-90, 14, 160)">must cite</text>

    <!-- Optional: cite RustQC (dashed, subtle) -->
    <path d="M284,44 L320,44 L320,148 L278,148"
      fill="none" stroke="var(--text-tertiary)" stroke-width="1.2"
      stroke-dasharray="5,4"
      marker-end="url(#arr-opt)" />
    <text x="326" y="104" text-anchor="middle"
      font-family="var(--font-sans)" font-size="10"
      fill="var(--text-tertiary)"
      transform="rotate(90, 326, 104)">optional</text>

    <!-- Legend at bottom -->
    <line x1="80" y1="330" x2="110" y2="330"
      stroke="var(--section-color, var(--accent-rust))" stroke-width="2" />
    <text x="118" y="334" font-family="var(--font-sans)" font-size="10"
      fill="var(--text-secondary)">Required citation</text>

    <line x1="80" y1="352" x2="110" y2="352"
      stroke="var(--text-tertiary)" stroke-width="1.2" stroke-dasharray="5,4" />
    <text x="118" y="356" font-family="var(--font-sans)" font-size="10"
      fill="var(--text-tertiary)">Optional citation</text>
  </svg>
  <div class="provenance-note">
    Users of a rewrite should know to cite the original too. This is how science tracks provenance.
  </div>
</div>

<style>
  .provenance-wrap {
    background: var(--bg-secondary);
    border-left: 3px solid var(--section-color, var(--accent-rust));
    padding: var(--space-lg);
  }

  .provenance-svg {
    width: 100%;
    max-width: 340px;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .provenance-note {
    font-family: var(--font-serif);
    font-size: 0.83rem;
    color: var(--text-tertiary);
    border-top: 1px solid rgba(230, 225, 216, 0.06);
    padding-top: var(--space-sm);
    margin-top: var(--space-md);
    line-height: 1.6;
    font-style: italic;
  }
</style>
