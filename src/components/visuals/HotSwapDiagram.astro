  <div class="swap-note">
    Same shape, different colour. Swap one piece without touching the rest. Fully reversible.
  </div>
</div>

<style>
  .swap-wrap {
    background: var(--bg-secondary);
    border-left: 3px solid var(--section-color, var(--accent-sage));
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .swap-pipeline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }

  .swap-piece {
    position: relative;
  }

  .swap-piece :global(svg) {
    width: 48px;
    height: 48px;
    display: block;
  }

  .swap-piece-dim :global(svg) {
    color: var(--text-tertiary);
    opacity: 0.25;
  }

  .swap-piece-active :global(svg) {
    width: 56px;
    height: 56px;
  }

  .swap-piece-original :global(svg) {
    color: var(--accent-rust);
  }

  .swap-piece-rewrite :global(svg) {
    color: var(--section-color, var(--accent-sage));
  }

  .swap-piece-label {
    position: absolute;
    bottom: -16px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  .swap-arrow {
    text-align: center;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--text-tertiary);
    padding: var(--space-sm) 0;
  }

  .swap-replacement {
    display: flex;
    justify-content: center;
    padding-bottom: var(--space-sm);
  }

  .swap-note {
    font-family: var(--font-serif);
    font-size: 0.83rem;
    color: var(--text-tertiary);
    border-top: 1px solid rgba(230, 225, 216, 0.06);
    padding-top: var(--space-sm);
    line-height: 1.6;
    font-style: italic;
  }
</style>
