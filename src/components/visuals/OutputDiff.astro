---
// 1.2 — Emulate exactly: puzzle pieces must be the same shape
// fa6-solid:puzzle-piece = correct shape (2 tabs, 2 holes)
// oi:puzzle-piece = wrong shape (2 tabs, 1 hole) — close but doesn't fit
---

<div class="puzzle-wrap">
  <div class="puzzle-row">
    <div class="puzzle-item puzzle-good">
      <svg class="puzzle-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path fill="currentColor" d="M192 104.8c0-9.2-5.8-17.3-13.2-22.8c-11.6-8.7-18.8-20.7-18.8-34c0-26.5 28.7-48 64-48s64 21.5 64 48c0 13.3-7.2 25.3-18.8 34c-7.4 5.5-13.2 13.6-13.2 22.8c0 12.8 10.4 23.2 23.2 23.2H336c26.5 0 48 21.5 48 48v56.8c0 12.8 10.4 23.2 23.2 23.2c9.2 0 17.3-5.8 22.8-13.2c8.7-11.6 20.7-18.8 34-18.8c26.5 0 48 28.7 48 64s-21.5 64-48 64c-13.3 0-25.3-7.2-34-18.8c-5.5-7.4-13.6-13.2-22.8-13.2c-12.8 0-23.2 10.4-23.2 23.2V464c0 26.5-21.5 48-48 48h-56.8c-12.8 0-23.2-10.4-23.2-23.2c0-9.2 5.8-17.3 13.2-22.8c11.6-8.7 18.8-20.7 18.8-34c0-26.5-28.7-48-64-48s-64 21.5-64 48c0 13.3 7.2 25.3 18.8 34c7.4 5.5 13.2 13.6 13.2 22.8c0 12.8-10.4 23.2-23.2 23.2H48c-26.5 0-48-21.5-48-48V343.2C0 330.4 10.4 320 23.2 320c9.2 0 17.3 5.8 22.8 13.2c8.7 11.6 20.7 18.8 34 18.8c26.5 0 48-28.7 48-64s-21.5-64-48-64c-13.3 0-25.3 7.2-34 18.8c-5.5 7.4-13.6 13.2-22.8 13.2C10.4 256 0 245.6 0 232.8V176c0-26.5 21.5-48 48-48h120.8c12.8 0 23.2-10.4 23.2-23.2"/></svg>
      <div class="puzzle-label">Good rewrite</div>
      <div class="puzzle-desc">Exact same shape</div>
      <div class="puzzle-badge puzzle-badge-pass">✓ fits</div>
    </div>
    <div class="puzzle-item puzzle-bad">
      <svg class="puzzle-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 8 8"><path fill="currentColor" d="M3 0c-.28 0-.54.1-.72.28S2 .72 2 1s.18.48.28.72c.03.06.03.16.03.28H0v6h2.31c0-.12-.01-.22-.03-.28C2.18 7.48 2 7.28 2 7s.1-.54.28-.72S2.72 6 3 6s.54.1.72.28S4 6.72 4 7s-.18.48-.28.72c-.03.06-.03.16-.03.28H6V5.69c.12 0 .22.01.28.03c.24.1.44.28.72.28s.54-.1.72-.28S8 5.28 8 5s-.1-.54-.28-.72S7.28 4 7 4s-.48.18-.72.28c-.06.03-.16.03-.28.03V2H3.69c0-.12.01-.22.03-.28c.1-.24.28-.44.28-.72S3.9.46 3.72.28S3.28 0 3 0"/></svg>
      <div class="puzzle-label">Bad rewrite</div>
      <div class="puzzle-desc">Different shape - close, but wrong</div>
      <div class="puzzle-badge puzzle-badge-fail">✗ doesn't fit</div>
    </div>
  </div>
</div>

<style>
  .puzzle-wrap {
    background: var(--bg-secondary);
    border-left: 3px solid var(--section-color, var(--accent-rust));
    padding: var(--space-lg);
  }

  .puzzle-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    margin-bottom: var(--space-md);
  }

  .puzzle-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-sm);
    padding: var(--space-md);
  }

  .puzzle-icon {
    width: 72px;
    height: 72px;
  }

  .puzzle-good .puzzle-icon {
    color: var(--color-pass);
  }

  .puzzle-bad .puzzle-icon {
    color: var(--color-fail);
  }

  .puzzle-label {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
  }

  .puzzle-desc {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }

  .puzzle-badge {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 2px 10px;
    border-radius: 3px;
  }

  .puzzle-badge-pass {
    background: rgba(93, 172, 114, 0.1);
    color: var(--color-pass);
    border: 1px solid rgba(93, 172, 114, 0.2);
  }

  .puzzle-badge-fail {
    background: rgba(212, 86, 90, 0.1);
    color: var(--color-fail);
    border: 1px solid rgba(212, 86, 90, 0.2);
  }

  .puzzle-note {
    font-family: var(--font-serif);
    font-size: 0.83rem;
    color: var(--text-tertiary);
    border-top: 1px solid rgba(230, 225, 216, 0.06);
    padding-top: var(--space-sm);
    line-height: 1.6;
    font-style: italic;
  }

  @media (max-width: 400px) {
    .puzzle-row {
      grid-template-columns: 1fr;
    }
  }
</style>
