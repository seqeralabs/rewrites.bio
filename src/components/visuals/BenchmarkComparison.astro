---
// 3.1 — Test and benchmark with real data: Reproducibility blueprint
---

<div class="blueprint-wrap">
  <div class="blueprint-layout">
    <div class="blueprint-header">
      <div class="blueprint-main-label">Benchmark</div>
      <div class="blueprint-main-sub">All four required for reproducibility</div>
    </div>
    <div class="blueprint-items">
      <div class="blueprint-item">

        <div class="blueprint-box">
          <div class="blueprint-item-name">Hardware</div>
          <div class="blueprint-item-detail">10-core M3 Max</div>
        </div>
      </div>
      <div class="blueprint-item">

        <div class="blueprint-box">
          <div class="blueprint-item-name">Dataset</div>
          <div class="blueprint-item-detail">GM12878 REP1, 10 GB</div>
        </div>
      </div>
      <div class="blueprint-item">

        <div class="blueprint-box">
          <div class="blueprint-item-name">Commands</div>
          <div class="blueprint-item-detail">exact CLI invocations</div>
        </div>
      </div>
      <div class="blueprint-item">

        <div class="blueprint-box">
          <div class="blueprint-item-name">Expected outputs</div>
          <div class="blueprint-item-detail">benchmarks/expected/</div>
        </div>
      </div>
    </div>
  </div>
  <div class="blueprint-note">
    Numbers without reproducibility are anecdotes.
  </div>
  <div class="blueprint-source">
    Source: <a href="https://seqeralabs.github.io/RustQC/rna/benchmark-details/" target="_blank" rel="noopener">seqeralabs.github.io/RustQC</a>
  </div>
</div>

<style>
  .blueprint-wrap {
    background: var(--bg-secondary);
    border-left: 3px solid var(--section-color, var(--accent-gold));
    padding: var(--space-lg);
  }

  .blueprint-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .blueprint-header {
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--section-color, var(--accent-gold));
  }

  .blueprint-main-label {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text-primary);
  }

  .blueprint-main-sub {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--section-color, var(--accent-gold));
  }

  .blueprint-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    flex: 1;
  }

  .blueprint-item {
    display: flex;
    align-items: center;
  }

  .blueprint-box {
    background: var(--bg-elevated);
    border: 1px solid rgba(230, 225, 216, 0.06);
    border-radius: 4px;
    padding: 6px 10px;
    flex: 1;
  }

  .blueprint-item-name {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .blueprint-item-detail {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }

  .blueprint-note {
    font-family: var(--font-serif);
    font-size: 0.83rem;
    color: var(--text-tertiary);
    border-top: 1px solid rgba(230, 225, 216, 0.06);
    padding-top: var(--space-sm);
    line-height: 1.6;
    font-style: italic;
  }

  .blueprint-source {
    font-family: var(--font-serif);
    font-size: 0.7rem;
    color: var(--text-tertiary);
    margin-top: var(--space-xs);
  }

  .blueprint-source a {
    color: var(--color-link);
    font-family: var(--font-mono);
    text-decoration: none;
  }
</style>
