---
import { readFileSync } from 'node:fs';
import { parse } from 'yaml';
import { marked } from 'marked';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Principle from '../components/Principle.astro';
import Footer from '../components/Footer.astro';

const manifesto = parse(readFileSync('src/data/manifesto.yaml', 'utf-8'));
const romanNumerals = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII'];

// Parse all principle descriptions as inline markdown
for (const section of manifesto.sections) {
  for (const p of section.principles) {
    p.description = await marked.parseInline(p.description.trim());
  }
}

// Parse callout as inline markdown (for emphasis)
const callout = await marked.parseInline(manifesto.callout.trim());
---

<Layout title="rewrites.bio - Rewrite it, for bioinformatics">
  <Hero />

  <main class="manifesto">
    <div class="preamble container reveal-stagger" id="introduction">
      {manifesto.preamble.map((paragraph: string) => (
        <p class="reveal">{paragraph.trim()}</p>
      ))}
      <p class="preamble-callout reveal" set:html={callout} />
      <p class="reveal">
        {manifesto.preamble_closing.trim()}
      </p>
    </div>

    {manifesto.sections.map((section: any, si: number) => (
      <Section id={section.title.toLowerCase().replace(/\s+/g, '-')} number={romanNumerals[si]} title={section.title}>
        {section.principles.map((p: any, pi: number) => (
          <Principle id={`principle-${si + 1}-${pi + 1}`} number={`${si + 1}.${pi + 1}`} title={p.title} description={p.description} />
        ))}
      </Section>
    ))}

    <section class="closing container">
      <div class="reveal">
        <div class="closing-line"></div>
        <p class="closing-text">
          The wave is coming.<br />
          Let us make sure it lifts all boats.
        </p>
        <p class="closing-attribution">
          {/* Read the paper: <em>The Bioinformatics Rewrite</em> (preprint coming soon)<br /> */}
          Plain text version: <a href="/manifesto.md"><code>rewrites.bio/manifesto.md</code></a>
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .manifesto {
    padding-top: var(--space-xl);
  }

  .preamble {
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: var(--space-2xl);
    scroll-margin-top: 72px;
  }

  .preamble p {
    font-size: 1.15rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin-bottom: var(--space-lg);
    max-width: 65ch;
  }

  .preamble-callout {
    font-family: var(--font-mono);
    font-size: 1.05rem !important;
    color: var(--rust-400) !important;
    border-left: 2px solid var(--rust-600);
    padding-left: var(--space-lg);
    margin: var(--space-xl) 0 !important;
    line-height: 1.8 !important;
  }

  .preamble-callout em {
    font-style: italic;
    color: var(--rust-300);
  }

  .closing {
    padding: var(--space-2xl) 0;
    text-align: center;
  }

  .closing-line {
    width: 48px;
    height: 2px;
    background: linear-gradient(90deg, var(--rust-600), var(--rust-400));
    margin: 0 auto var(--space-xl);
  }

  .closing-text {
    font-family: var(--font-mono);
    font-size: clamp(1.2rem, 2.5vw, 1.6rem);
    color: var(--text-primary);
    line-height: 1.6;
    margin-bottom: var(--space-xl);
  }

  .closing-text a {
    color: inherit;
  }
  .closing-text a:hover {
    color: var(--rust-400);
  }

  .closing-attribution {
    font-size: 0.9rem;
    color: var(--text-tertiary);
    line-height: 1.8;
  }

  .closing-attribution a {
    color: inherit;
  }
  .closing-attribution a:hover {
    color: var(--rust-400);
  }

</style>
