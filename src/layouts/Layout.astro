---
import '../styles/global.css';
import SeqeraLogo from '../components/visuals/seqera-logo.svg';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Principles for responsible AI-assisted rewriting of bioinformatics tools.',
} = Astro.props;

const siteUrl = Astro.site?.origin ?? Astro.url.origin;
const ogImage = `${siteUrl}/og-image.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="rewrites.bio - Rewriting bioinformatics tools with AI. Responsibly." />
    <meta property="og:site_name" content="rewrites.bio" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="rewrites.bio - Rewriting bioinformatics tools with AI. Responsibly." />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="progress-bar" id="progress-bar"></div>
    <nav class="site-nav">
      <a href="/" class="nav-brand">
        <span class="nav-rewrites">rewrites</span><span class="nav-dot">.</span><span class="nav-bio">bio</span>
      </a>
      <button class="nav-toc-toggle" id="nav-toc-toggle" aria-expanded="false" aria-controls="toc-sidebar">
        <svg class="nav-toc-icon" width="16" height="14" viewBox="0 0 16 14" fill="none">
          <line x1="0" y1="1" x2="16" y2="1" stroke="currentColor" stroke-width="1.5"/>
          <line x1="3" y1="7" x2="16" y2="7" stroke="currentColor" stroke-width="1.5"/>
          <line x1="3" y1="13" x2="16" y2="13" stroke="currentColor" stroke-width="1.5"/>
        </svg>
        <span class="nav-toc-label">Contents</span>
      </button>
      <a href="https://seqera.io" class="nav-seqera-link"><SeqeraLogo /></a>
    </nav>

    <slot />

    <script>
      // Intersection Observer for reveal animations
      function initReveals() {
        const reveals = document.querySelectorAll('.reveal');
        let initialLoad = true;

        setTimeout(() => {
          const observer = new IntersectionObserver(
            (entries) => {
              if (initialLoad) {
                const visible = entries
                  .filter((e) => e.isIntersecting)
                  .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

                visible.forEach((entry, i) => {
                  const el = entry.target;
                  const baseDelay = parseFloat(getComputedStyle(el).transitionDelay) * 1000 || 0;
                  el.style.transitionDelay = `${baseDelay + i * 60}ms`;
                  el.classList.add('visible');
                  el.addEventListener('transitionend', () => {
                    el.style.transitionDelay = '';
                  }, { once: true });
                });

                initialLoad = false;
                return;
              }

              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('visible');
                }
              });
            },
            { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
          );

          reveals.forEach((el) => observer.observe(el));
        }, 0);
      }

      // Track active section/principle in the table of contents
      function initTocTracker() {
        const tocItems = document.querySelectorAll('[data-toc]');
        if (!tocItems.length) return;

        // Collect all tracked elements
        const tracked = [];
        tocItems.forEach((item) => {
          const targetId = item.getAttribute('data-toc');
          const target = targetId ? document.getElementById(targetId) : null;
          if (target) {
            tracked.push({ item, target });
          }
        });

        let ticking = false;
        let lastActiveItem = null;

        function updateActive() {
          const navHeight = 64;
          let activeItem = null;

          // Find the lowest element whose top is above the probe point
          for (const { item, target } of tracked) {
            const rect = target.getBoundingClientRect();
            if (rect.top < navHeight + 120 && rect.bottom > navHeight) {
              activeItem = item;
            }
          }

          // Keep last active item during gaps between sections
          if (!activeItem && lastActiveItem) {
            activeItem = lastActiveItem;
          }
          lastActiveItem = activeItem;

          tocItems.forEach((item) => item.classList.remove('active'));
          if (activeItem) {
            activeItem.classList.add('active');
            // Scroll the ToC sidebar to keep active item visible
            const sidebar = document.getElementById('toc-sidebar');
            if (sidebar && window.innerWidth >= 1200) {
              const itemRect = activeItem.getBoundingClientRect();
              const sidebarRect = sidebar.getBoundingClientRect();
              if (itemRect.bottom > sidebarRect.bottom || itemRect.top < sidebarRect.top) {
                activeItem.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
              }
            }
          }

          ticking = false;
        }

        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(updateActive);
            ticking = true;
          }
        }, { passive: true });

        updateActive();
      }

      // Mobile ToC toggle
      function initTocToggle() {
        const toggle = document.getElementById('nav-toc-toggle');
        const sidebar = document.getElementById('toc-sidebar');
        if (!toggle || !sidebar) return;

        function openToc() {
          sidebar.classList.add('open');
          toggle.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        }

        function closeToc() {
          sidebar.classList.remove('open');
          toggle.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        }

        toggle.addEventListener('click', (e) => {
          e.stopPropagation();
          if (sidebar.classList.contains('open')) {
            closeToc();
          } else {
            openToc();
          }
        });

        // Close when clicking a ToC link (mobile)
        sidebar.addEventListener('click', (e) => {
          if (e.target.closest('.toc-item') && window.innerWidth < 1200) {
            closeToc();
          }
        });

        // Close on click outside
        document.addEventListener('click', (e) => {
          if (!sidebar.contains(e.target) && !toggle.contains(e.target)) {
            closeToc();
          }
        });

        // Close on Escape
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && sidebar.classList.contains('open')) {
            closeToc();
          }
        });
      }

      // Horizontal progress bar at top of page
      function initProgressBar() {
        const bar = document.getElementById('progress-bar');
        if (!bar) return;

        let ticking = false;
        function update() {
          const scrollTop = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const progress = docHeight > 0 ? Math.min(scrollTop / docHeight, 1) : 0;
          bar.style.transform = `scaleX(${progress})`;
          ticking = false;
        }

        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(update);
            ticking = true;
          }
        }, { passive: true });

        update();
      }

      initReveals();
      initTocTracker();
      initTocToggle();
      initProgressBar();
      document.addEventListener('astro:after-swap', () => {
        initReveals();
        initTocTracker();
        initTocToggle();
        initProgressBar();
      });
    </script>
  </body>
</html>

<style>
  .progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--accent-rust);
    transform-origin: left;
    transform: scaleX(0);
    z-index: 1000;
    pointer-events: none;
    transition: transform 0.1s ease-out;
  }

  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 999;
    display: flex;
    align-items: center;
    padding: var(--space-md) var(--space-lg);
    background: var(--bg-primary);
    border-bottom: 1px solid rgba(230, 225, 216, 0.06);
  }

  .nav-brand {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .nav-rewrites { color: var(--text-primary); }
  .nav-dot { color: var(--accent-rust); }
  .nav-bio { color: var(--accent-rust); }

  /* Mobile ToC toggle — hidden on desktop where sidebar is visible */
  .nav-toc-toggle {
    all: unset;
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: var(--space-md);
    padding: 4px 10px;
    border-radius: 4px;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-tertiary);
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .nav-toc-toggle:hover {
    color: var(--text-secondary);
    background: rgba(230, 225, 216, 0.04);
  }

  .nav-toc-icon {
    flex-shrink: 0;
  }

  @media (min-width: 1200px) {
    .nav-toc-toggle {
      display: none;
    }
  }

  .nav-seqera-link {
    margin-left: auto;
    display: flex;
    align-items: center;
    opacity: 0.35;
    transition: opacity 0.2s ease;
  }

  .nav-seqera-link:hover {
    opacity: 0.7;
  }

  .nav-seqera-link :global(svg) {
    height: 1.8em;
    width: auto;
  }

  @media (max-width: 768px) {
    .nav-seqera-link {
      display: none;
    }
    .nav-toc-label {
      display: none;
    }
  }
</style>
